# Fill with independent random secrets of at least 32 bytes.
# Local development only; never commit the populated .dev.vars file.
LOCAL_ADMIN_SECRET=
TOKEN_HASH_SECRET=

# Optional daily call-summary email. Keep disabled for normal local development.
CALL_SUMMARY_ENABLED=false
EMAIL_IDS=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional: MAILGUN_FROM_EMAIL defaults to postmaster@MAILGUN_DOMAIN.
# MAILGUN_REGION defaults to us; set eu for a European Mailgun domain.

# Local development only: print employee web sign-in codes to the console (ignored on any deployed Worker).
# WEB_OTP_DEV_LOG=true
